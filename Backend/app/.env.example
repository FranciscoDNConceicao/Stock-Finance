# Copiar para Backend/app/.env e preencher. Nunca fazer commit do .env.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
API_NINJA_KEY=
POLYGON_API_KEY=
DOMAIN=localhost
ENVIRONMENT=local
DATABASE_NAME=stockfinance_db
DATABASE_IP=localhost
DATABASE_USER=admin
DATABASE_PASSWORD=
DATABASE_PORT=5432
originCORS=["http://localhost:5173"]

# Autenticação (JWT). Obrigatório fora de ENVIRONMENT=local; em local, se vazio,
# é gerado um segredo aleatório a cada arranque.
JWT_SECRET_KEY=
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Carteira virtual: saldo inicial de cada conta nova
# WALLET_STARTING_BALANCE=10000

# Rate limiting por IP (sintaxe "N/second|minute|hour|day")
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT=120/minute
# RATE_LIMIT_AUTH=10/minute
# RATE_LIMIT_EXTERNAL=30/minute
# RATE_LIMIT_STORAGE_URI=          # vazio = memória; redis://host:6379 com vários workers
