# Variáveis usadas pelo docker-compose.yml (copiar para .env na raiz e preencher).
# Nunca fazer commit do .env.

# Base de dados
POSTGRES_USER=admin
POSTGRES_DB=stockfinance_db
POSTGRES_PASSWORD=

# Backend: chaves das APIs externas
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
API_NINJA_KEY=
POLYGON_API_KEY=

# Autenticação: obrigatório fora de ENVIRONMENT=local.
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Opcionais (têm valores por omissão no docker-compose.yml)
# DOMAIN=localhost
# ENVIRONMENT=local
# ORIGIN_CORS=["http://localhost:5173"]

# Scheduler (cron: minuto hora dia mês dia-da-semana; dias da semana por nome)
# SCHEDULER_TIMEZONE=UTC
# SCHEDULER_STOCKS_CRON=0 6 * * tue-sat
# SCHEDULER_NEWS_CRON=0 7 * * *
# SCHEDULER_RUN_ON_START=false
